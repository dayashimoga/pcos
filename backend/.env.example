# PCOS Environment Configuration
# Copy this file to .env and fill in the values

# ─── Server ──────────────────────────────────────────────
PCOS_SERVER__HOST=0.0.0.0
PCOS_SERVER__PORT=8080

# ─── Database ────────────────────────────────────────────
PCOS_DATABASE__URL=postgresql://pcos:pcos_secret@postgres:5432/pcos
PCOS_DATABASE__MAX_CONNECTIONS=20
PCOS_DATABASE__MIN_CONNECTIONS=5

# ─── Authentication ──────────────────────────────────────
# IMPORTANT: Change this to a unique random string!
# Generate with: openssl rand -base64 64
PCOS_AUTH__JWT_SECRET=CHANGE-ME-TO-A-SECURE-RANDOM-STRING-AT-LEAST-64-CHARACTERS-LONG!!
PCOS_AUTH__ACCESS_TOKEN_EXPIRY_SECS=900
PCOS_AUTH__REFRESH_TOKEN_EXPIRY_SECS=604800

# ─── Redis ───────────────────────────────────────────────
PCOS_REDIS__URL=redis://redis:6379

# ─── Storage ─────────────────────────────────────────────
# Path where files are stored (inside Docker volume or local path)
PCOS_STORAGE__BASE_PATH=/data/pcos/storage
PCOS_STORAGE__MAX_UPLOAD_SIZE_MB=10240

# ─── AI (Optional — uses local Ollama, zero cost) ───────
PCOS_AI__URL=http://ollama:11434
PCOS_AI__MODEL=llama3.1

# ─── Logging ─────────────────────────────────────────────
RUST_LOG=pcos=info,tower_http=info,sqlx=warn

# ─── SQLx Offline (for Docker builds) ───────────────────
SQLX_OFFLINE=true
