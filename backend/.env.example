# ─── PCOS Backend Configuration ──────────────────────────
# Copy this file to `.env` and fill in the values.
# Environment variables use PCOS_ prefix with __ separator for nesting.

# ─── Server ──────────────────────────────────────────────
PCOS_SERVER__HOST=0.0.0.0
PCOS_SERVER__PORT=8080

# ─── Database ────────────────────────────────────────────
PCOS_DATABASE__URL=postgresql://pcos:pcos_secret@localhost:5432/pcos
PCOS_DATABASE__MAX_CONNECTIONS=20
PCOS_DATABASE__MIN_CONNECTIONS=5

# ─── Authentication ─────────────────────────────────────
# IMPORTANT: Generate a random 64+ character secret for production!
# Example: openssl rand -base64 64
PCOS_AUTH__JWT_SECRET=CHANGE-ME-TO-A-SECURE-RANDOM-STRING-AT-LEAST-64-CHARACTERS-LONG!!
PCOS_AUTH__ACCESS_TOKEN_EXPIRY_SECS=900
PCOS_AUTH__REFRESH_TOKEN_EXPIRY_SECS=604800

# ─── Redis ───────────────────────────────────────────────
PCOS_REDIS__URL=redis://localhost:6379

# ─── Storage ─────────────────────────────────────────────
PCOS_STORAGE__BASE_PATH=/data/pcos/storage
PCOS_STORAGE__MAX_UPLOAD_SIZE_MB=10240

# ─── AI (Ollama) ─────────────────────────────────────────
PCOS_AI__URL=http://localhost:11434
PCOS_AI__MODEL=llama3.1

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for development only.
PCOS_CORS_ORIGINS=*

# ─── Public URL (for share links) ────────────────────────
PCOS_PUBLIC_URL=http://localhost:8080

# ─── Logging ─────────────────────────────────────────────
RUST_LOG=pcos=info,tower_http=info,sqlx=warn
