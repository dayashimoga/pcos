{
  "annotations": { "list": [] },
  "title": "PCOS - Personal Cloud Operating System",
  "uid": "pcos-overview",
  "version": 1,
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{path}}" }]
    },
    {
      "title": "Request Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" }]
    },
    {
      "title": "Active Users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "pcos_active_users_total", "legendFormat": "Users" }]
    },
    {
      "title": "Total Files",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "pcos_files_total", "legendFormat": "Files" }]
    },
    {
      "title": "Storage Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "pcos_storage_bytes_total", "legendFormat": "Bytes" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Active Shares",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "pcos_active_shares_total", "legendFormat": "Shares" }]
    },
    {
      "title": "Upload/Download Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(pcos_uploads_bytes_total[5m])", "legendFormat": "Upload" },
        { "expr": "rate(pcos_downloads_bytes_total[5m])", "legendFormat": "Download" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "5xx" },
        { "expr": "rate(http_requests_total{status=~\"4..\"}[5m])", "legendFormat": "4xx" }
      ]
    },
    {
      "title": "Database Connection Pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "pcos_db_pool_active", "legendFormat": "Active" },
        { "expr": "pcos_db_pool_idle", "legendFormat": "Idle" },
        { "expr": "pcos_db_pool_max", "legendFormat": "Max" }
      ]
    },
    {
      "title": "Sync WebSocket Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "pcos_websocket_connections", "legendFormat": "Active WS" }]
    },
    {
      "title": "Background Jobs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "pcos_jobs_completed_total", "legendFormat": "Completed" },
        { "expr": "pcos_jobs_failed_total", "legendFormat": "Failed" }
      ]
    },
    {
      "title": "AI Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "rate(pcos_ai_requests_total[5m])", "legendFormat": "{{operation}}" }
      ]
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s"
}
