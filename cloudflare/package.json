{
  "name": "pcos-control-plane",
  "version": "1.0.0",
  "description": "PCOS Always-Available Cloudflare Edge Control Plane",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "provision": "node scripts/provision.mjs",
    "test": "vitest run",
    "d1:init": "wrangler d1 execute pcos-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute pcos-db --remote --file=./schema.sql"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^3.84.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
