# ─── PCOS Environment Configuration ─────────────────────
# Copy this file to .env and customize for your deployment
# Usage: cp .env.example .env && docker compose up -d

# ─── Security (REQUIRED — change these!) ────────────────
PCOS_JWT_SECRET=CHANGE-ME-TO-A-SECURE-RANDOM-STRING-AT-LEAST-64-CHARACTERS-LONG-GENERATE-WITH-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-to-a-strong-database-password

# ─── Database ───────────────────────────────────────────
POSTGRES_USER=pcos
POSTGRES_DB=pcos
PCOS_DATABASE__URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ─── Server ─────────────────────────────────────────────
PCOS_SERVER__HOST=0.0.0.0
PCOS_SERVER__PORT=8080

# ─── Storage ────────────────────────────────────────────
PCOS_STORAGE__BASE_PATH=/data/pcos/storage
PCOS_STORAGE__MAX_UPLOAD_SIZE_MB=10240

# ─── AI (Optional — Ollama for local inference) ────────
PCOS_AI__URL=http://ollama:11434
PCOS_AI__MODEL=llama3.1

# ─── Redis ──────────────────────────────────────────────
PCOS_REDIS__URL=redis://redis:6379

# ─── SMTP Email (Optional) ─────────────────────────────
# PCOS_SMTP_HOST=smtp.gmail.com
# PCOS_SMTP_PORT=587
# PCOS_SMTP_USER=your@gmail.com
# PCOS_SMTP_PASS=app-password
# PCOS_SMTP_FROM=noreply@your-domain.com

# ─── CORS (comma-separated origins, or * for dev) ─────
PCOS_CORS_ORIGINS=*

# ─── Logging ────────────────────────────────────────────
RUST_LOG=pcos=info,tower_http=info,sqlx=warn

# ─── Monitoring ─────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
