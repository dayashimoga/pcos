# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure LF line endings for all Dart, Rust, and script files across Windows, Linux, and macOS
*.dart text eol=lf
*.rs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
