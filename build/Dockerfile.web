# Flutter Web Builder (production-optimized)
# Usage: docker build -f build/Dockerfile.web -t pcos-web ../frontend
FROM ghcr.io/cirruslabs/flutter:3.24.0 AS builder

WORKDIR /app
COPY pubspec.yaml pubspec.loc[k] ./
RUN flutter pub get

COPY . .
RUN flutter build web --release --web-renderer canvaskit --no-tree-shake-icons

# Serve with nginx
FROM nginx:alpine
COPY --from=builder /app/build/web /usr/share/nginx/html
COPY nginx.con[f] /etc/nginx/conf.d/default.conf
EXPOSE 80
