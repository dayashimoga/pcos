# Flutter Linux Desktop Builder
# Usage: docker build -f build/Dockerfile.linux -t pcos-linux ../frontend
# Extract: docker cp $(docker create pcos-linux):/artifacts/ ./artifacts/linux/
FROM ghcr.io/cirruslabs/flutter:3.24.0 AS builder

# Install Linux desktop build dependencies
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang cmake ninja-build pkg-config \
    libgtk-3-dev liblzma-dev libstdc++-12-dev \
    libblkid-dev libsecret-1-dev libjsoncpp-dev \
    patchelf file desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pubspec.yaml pubspec.loc[k] ./
RUN flutter config --enable-linux-desktop && flutter pub get

COPY . .

# Build Linux release
RUN rm -rf linux && flutter create --platforms=linux . && flutter build linux --release

# Create AppImage structure
RUN mkdir -p /app/build/linux/x64/release/bundle /AppDir/usr/bin /AppDir/usr/share/icons/hicolor/256x256/apps /AppDir/usr/share/applications && \
    (cp -r /app/build/linux/x64/release/bundle/* /AppDir/usr/bin/ 2>/dev/null || true) && \
    # Create .desktop file
    echo '[Desktop Entry]' > /AppDir/usr/share/applications/pcos.desktop && \
    echo 'Name=PCOS' >> /AppDir/usr/share/applications/pcos.desktop && \
    echo 'Comment=Personal Cloud Operating System' >> /AppDir/usr/share/applications/pcos.desktop && \
    echo 'Exec=pcos_frontend' >> /AppDir/usr/share/applications/pcos.desktop && \
    echo 'Icon=pcos' >> /AppDir/usr/share/applications/pcos.desktop && \
    echo 'Type=Application' >> /AppDir/usr/share/applications/pcos.desktop && \
    echo 'Categories=Utility;FileManager;Network;' >> /AppDir/usr/share/applications/pcos.desktop && \
    cp /AppDir/usr/share/applications/pcos.desktop /AppDir/ && \
    ln -sf usr/bin/pcos_frontend /AppDir/AppRun 2>/dev/null || true

# Output stage
FROM alpine:3.20
COPY --from=builder /app/build/linux/x64/release/bundle/ /artifacts/linux-bundle/
COPY --from=builder /AppDir/ /artifacts/AppDir/
CMD ["ls", "-laR", "/artifacts/"]
