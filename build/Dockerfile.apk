# Flutter Android APK Builder
FROM ghcr.io/cirruslabs/flutter:3.24.0 AS apk-builder

WORKDIR /app
COPY pubspec.yaml pubspec.lock* ./
RUN flutter pub get

COPY . .

# Download and install Gradle 8.3 globally
RUN curl -L -o /tmp/gradle.zip https://github.com/gradle/gradle-distributions/releases/download/v8.3.0/gradle-8.3-bin.zip && \
    unzip -q /tmp/gradle.zip -d /opt && \
    rm /tmp/gradle.zip

ENV PATH="/opt/gradle-8.3/bin:${PATH}"

# Build APK using global Gradle 8.3
RUN cd android && gradle assembleRelease && mkdir -p /app/build/app/outputs/flutter-apk && find . -name "*.apk" -exec cp {} /app/build/app/outputs/flutter-apk/ \;
