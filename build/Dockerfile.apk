# Flutter Android APK Builder
FROM ghcr.io/cirruslabs/flutter:3.24.0 AS apk-builder

WORKDIR /app
COPY pubspec.yaml pubspec.lock* ./
RUN flutter pub get

COPY . .

# Pre-download Gradle 8.3 distribution for wrapper cache
RUN mkdir -p /root/.gradle/wrapper/dists/gradle-8.3-bin/cached && \
    curl -L -o /root/.gradle/wrapper/dists/gradle-8.3-bin/cached/gradle-8.3-bin.zip https://github.com/gradle/gradle-distributions/releases/download/v8.3.0/gradle-8.3-bin.zip

# Build release APK using flutter build apk to target physical Android ARM architectures
RUN flutter build apk --release --no-tree-shake-icons
